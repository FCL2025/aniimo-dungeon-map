{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "伊莫地城地圖",
  "version": "0.2.43",
  "identifier": "local.aniimo.dungeonmap",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' data: ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDMTQwMUJGRTdDQkM2RDUKUldUVnhzdm52d0VVUEFxY1doWGZyRit1R0o1NmZXNjI1U0JWSVpNRitkMDNPbHZCSHArRUttQUMK",
      "endpoints": ["https://github.com/FCL2025/aniimo-dungeon-map/releases/latest/download/latest.json"]
    }
  }
}
